# Used by docker-compose.yml only (variable substitution) — has no effect on
# `npm run start:dev` outside Docker, that reads backend/.env instead.
#
# Copy to .env and edit here when switching auth method or exposing the backend
# through a tunnel, instead of digging into backend/.env.

# api_key (default) uses WORKSECTION_ACCOUNT_URL/WORKSECTION_API_KEY in backend/.env;
# oauth uses the WORKSECTION_OAUTH_* settings there and requires logging in via
# /auth/worksection/login.
WORKSECTION_AUTH_METHOD=api_key

# Whether the platform itself gates access behind a Worksection login, independently of
# WORKSECTION_AUTH_METHOD above (which only picks how the backend authenticates ITS OWN
# requests to the Worksection API). off (default) shows the report to anyone, no login step.
# worksection_oauth requires completing /auth/worksection/login before the report is shown.
# These two are independent: WORKSECTION_AUTH_METHOD=api_key + AUTH_METHOD=worksection_oauth
# means the platform login uses Worksection OAuth, but API calls still use the static API key;
# WORKSECTION_AUTH_METHOD=oauth + AUTH_METHOD=off means the platform has no login gate, but the
# shared Worksection OAuth connection still needs to be established via /auth/worksection/login
# for API calls to work.
AUTH_METHOD=off

# Where the backend is actually reachable from the browser. Drives BOTH the
# frontend's VITE_API_URL and the backend's OAuth redirect URI (…/auth/worksection/callback
# is appended automatically) — they must always be the same origin, otherwise the
# OAuth state cookie set during /login won't be sent back on /callback.
# Also register this + /auth/worksection/callback as the redirect URI in
# Worksection's OAuth app settings.
# Example when tunneling: BACKEND_PUBLIC_URL=https://<random>.trycloudflare.com
BACKEND_PUBLIC_URL=http://localhost:3001
