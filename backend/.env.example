PORT=3001
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://worksection:worksection@localhost:5432/worksection

# api_key (default) uses WORKSECTION_ACCOUNT_URL/WORKSECTION_API_KEY below; oauth uses the
# WORKSECTION_OAUTH_* settings and requires logging in via /auth/worksection/login.
WORKSECTION_AUTH_METHOD=api_key

WORKSECTION_ACCOUNT_URL=https://youraccount.worksection.com
WORKSECTION_API_KEY=

# Register an app at https://youraccount.worksection.com account settings > API to get these.
WORKSECTION_OAUTH_CLIENT_ID=
WORKSECTION_OAUTH_CLIENT_SECRET=
WORKSECTION_OAUTH_REDIRECT_URI=http://localhost:3001/auth/worksection/callback
WORKSECTION_OAUTH_SCOPE=projects_read tasks_read costs_read tags_read comments_read files_read users_read contacts_read
