generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton row (id fixed to 1) holding the app-wide Worksection OAuth connection: the app has no
// per-viewer identity, so a single stored token pair is used for every request when
// WORKSECTION_AUTH_METHOD=oauth, mirroring the single static WORKSECTION_API_KEY it replaces.
model WorksectionConnection {
  id                Int      @id @default(1)
  accountUrl        String
  accessToken       String
  refreshToken      String
  expiresAt         DateTime
  worksectionUserId String
  email             String
  firstName         String
  lastName          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
